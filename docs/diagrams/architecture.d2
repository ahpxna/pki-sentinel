# pki-sentinel architecture — regenerate the SVG with `make diagrams`
# (requires the `d2` CLI: https://d2lang.com)

issuance: Issuance plane {
  root_ca: "Vault: pki_root\n(Root CA, offline-style)"
  int_ca: "Vault: pki_int\n(Issuing CA, ACME, CRL/OCSP)"
  traefik: "Traefik\n(ACME client, TLS edge)"
  demo_api: "demo-api\n(AppRole + KV + client cert)"

  root_ca -> int_ca: signs
  int_ca -> traefik: ACME
  int_ca -> demo_api: client cert
}

assurance: Assurance plane (the differentiator) {
  style.fill: "#2b3a4a"
  controller: "Scenario controller\nissue -> preflight -> revoke"
  fault_proxy: "Responder fault proxy\nOCSP path only"
  oracles: "Status oracles\nOCSP direct + CRL"
  clients: "Isolated executors\none container/profile"
  evidence: "Evidence engine\ndecision + reason + hashes + signatures"
  drift: "Truststore exporter\nsigned policy conformance"

  controller -> fault_proxy
  fault_proxy -> oracles: OCSP fault path
  controller -> clients: manifest evidence barriers
  oracles -> evidence
  clients -> evidence
}

governance: Governance plane {
  prometheus: Prometheus
  grafana: Grafana dashboards
  alertmanager: "Alertmanager -> Slack / webhook-logger"
  wazuh: "Optional Wazuh\ndecoder/rule + fixture gate"

  prometheus -> grafana
  prometheus -> alertmanager
}

assurance.controller -> issuance.int_ca: canary issue/revoke
assurance.evidence -> governance.prometheus: pki_assurance_* metrics
assurance.drift -> governance.prometheus: pki_truststore_* metrics
issuance.int_ca -> governance.wazuh: optional audit parser
