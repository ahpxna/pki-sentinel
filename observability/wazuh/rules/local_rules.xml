<!--
  Custom rules for Vault audit-log events, keyed on JSON fields produced by
  observability/wazuh/decoders/vault_audit.xml and the truststore-drift-agent
  event stream.

  Rule 100102 is the highest-value rule in this set: with a properly
  bootstrapped hierarchy, pki_root is written to exactly once (during
  Terraform apply in Phase 1). Any later write is either an operator
  mistake or an attack, and should page, not just log.
-->
<group name="pki-sentinel,vault_audit,">

  <rule id="100100" level="0">
    <!-- Wazuh's built-in JSON decoder has precedence over custom JSON
         decoders. request.path distinguishes Vault audit records from other
         JSON events without depending on decoder ordering. -->
    <decoded_as>json</decoded_as>
    <field name="request.path">.+</field>
    <description>Vault audit event.</description>
  </rule>

  <rule id="100101" level="5">
    <decoded_as>json</decoded_as>
    <field name="request.path">^pki_int/revoke</field>
    <description>Certificate revoked via pki_int.</description>
    <group>pki_revocation,</group>
  </rule>

  <rule id="100102" level="12">
    <decoded_as>json</decoded_as>
    <field name="request.path">^pki_root/</field>
    <!-- Wazuh 4.8.2 rejects request.operation as a field selector in this
         ruleset (analysisd error 5107). Match the operation in raw JSON while
         retaining request.path as the structural selector. -->
    <regex type="pcre2">&quot;operation&quot;\s*:\s*&quot;(?:create|update|delete)&quot;</regex>
    <description>Root CA mount written — should essentially never happen after initial bootstrap.</description>
    <group>pki_root_write,</group>
  </rule>

  <rule id="100103" level="8">
    <decoded_as>json</decoded_as>
    <field name="request.path">^auth/</field>
    <field name="error">.+</field>
    <description>Vault auth failure.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100104" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100103</if_matched_sid>
    <same_field>request.remote_address</same_field>
    <description>Possible AppRole brute force: 5+ auth failures in 60s from the same source.</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100105" level="10">
    <decoded_as>json</decoded_as>
    <field name="request.path">^sys/policy</field>
    <regex type="pcre2">&quot;operation&quot;\s*:\s*&quot;(?:create|update|delete)&quot;</regex>
    <description>Vault policy modified.</description>
    <group>pki_policy_change,</group>
  </rule>

  <rule id="100106" level="12">
    <field name="event">^UNKNOWN_ROOT_ADDED$</field>
    <description>truststore-drift-agent: unauthorized root CA installed.</description>
    <group>truststore_drift,</group>
  </rule>

</group>
