{
  "title": "Trust Store Drift",
  "uid": "pki-trust-drift",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["pki-sentinel", "assurance"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unknown roots currently detected",
      "description": "truststore-drift-agent: SHA-256(SPKI) roots present in the host trust store but absent from the signed baseline. Any non-zero value here means an unauthorized CA has been installed. See docs/runbooks and the truststore-drift-agent README for why this can't be detected at the TLS layer.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pki_truststore_unknown_roots", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unknown roots over time",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pki_truststore_unknown_roots", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signed baseline valid",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pki_truststore_baseline_valid", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trust policy deviations",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pki_truststore_unknown_roots", "instant": true, "refId": "A" },
        { "expr": "pki_truststore_missing_roots", "instant": true, "refId": "B" },
        { "expr": "pki_truststore_changed_roots", "instant": true, "refId": "C" },
        { "expr": "pki_truststore_expired_roots", "instant": true, "refId": "D" },
        { "expr": "pki_truststore_expiring_roots", "instant": true, "refId": "E" }
      ]
    }
  ]
}
