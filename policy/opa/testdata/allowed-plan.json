{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "vault_pki_secret_backend_role.server",
      "type": "vault_pki_secret_backend_role",
      "change": {
        "after": {
          "name": "server",
          "server_flag": true,
          "allow_glob_domains": false,
          "allow_subdomains": true,
          "max_ttl": "24h"
        }
      }
    },
    {
      "address": "vault_pki_secret_backend_role.canary",
      "type": "vault_pki_secret_backend_role",
      "change": {
        "after": {
          "name": "canary",
          "server_flag": true,
          "allow_glob_domains": false,
          "allow_subdomains": true,
          "max_ttl": "30m"
        }
      }
    },
    {
      "address": "vault_pki_secret_backend_config_urls.int",
      "type": "vault_pki_secret_backend_config_urls",
      "change": {
        "after": {
          "ocsp_servers": ["http://vault:8200/v1/pki_int/ocsp"]
        }
      }
    }
  ]
}
