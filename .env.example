# ── pki-sentinel environment ──────────────────────────────────────────────
# Copy to .env and adjust as needed. .env is gitignored; never commit real secrets.

# Pinned image versions — single source of truth. No :latest anywhere.
VAULT_IMAGE=hashicorp/vault:1.21.4
# Apache-2.0 alternative, drop-in: openbao/openbao:2.0.0
TRAEFIK_IMAGE=traefik:v3.7.9
PROMETHEUS_IMAGE=prom/prometheus:v2.53.1
GRAFANA_IMAGE=grafana/grafana:11.1.3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
GO_VERSION=1.26.7
TERRAFORM_VERSION=1.9.5
TERRAFORM_VAULT_PROVIDER="~> 4.3"
WAZUH_VERSION=4.8.2

# Go module and repository owner.
OWNER=ahpxna

COMPOSE_PROJECT_NAME=pki-sentinel

# Writable probe bind mounts are owned by this non-root runtime identity.
# `make env` rewrites these two values in the ignored .env file to the
# invoking host user's UID/GID on Linux so local evidence remains accessible.
PROBE_RUNTIME_UID=10001
PROBE_RUNTIME_GID=10001

# Host ports (all configurable so this stack never collides with existing services)
# Administrative/control-plane ports bind to loopback by default. Set this
# explicitly to 0.0.0.0 only when remote access is intended and firewalled.
HOST_BIND_ADDRESS=127.0.0.1
VAULT_PORT=8200
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
PROBE_METRICS_PORT=9110

GRAFANA_ADMIN_PASSWORD=changeme-local-only
SLACK_WEBHOOK_URL=

PKI_DOMAIN=internal
ORG_NAME="PKI Sentinel Demo"

# Local root token used only to initialize the persistent seal Vault (a demo
# stand-in for a cloud KMS — see docs/adr/0002-auto-unseal-tradeoffs.md).
VAULT_SEAL_TOKEN=seal-dev-token

# Guard used by scripts/bootstrap.sh — defaults to revoking the root token after
# bootstrap. Set to 1 only for local iteration/debugging.
PKI_SENTINEL_KEEP_ROOT=0
